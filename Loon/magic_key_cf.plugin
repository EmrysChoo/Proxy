#!name = 神秘钥匙 · CF直连版
#!desc = v2.4 · TMDB 反代可开关（经 Cloudflare Worker 中转 / 直连）+ 成人内容解锁；T66Y/Forward/DriveMBY 解锁
#!author = Evan
#!version = 2.4-cf
#!updated = 2026-10-10
#!homepage = https://github.com/EmrysChoo/Proxy
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Media.png
#!loon_version = 3.5.1(978)

[Argument]
cfproxy = switch,true,tag=启用 CF 反代,desc=开启：TMDB 经 Cloudflare Worker 中转（无需代理节点）；关闭：直连 TMDB

[Rewrite]
# ===== 反代模式（开关开启）：TMDB 经 Cloudflare Worker =====
request if ${cfproxy} == true && ${url} ~= /^https?:\/\/api\.themoviedb\.org(\/.*)$/ as a then redirect(302, "https://tmdb-proxy.me-zhuxy.workers.dev${a.1}")
request if ${cfproxy} == true && ${url} ~= /^https?:\/\/image\.tmdb\.org(\/.*)$/ as b then redirect(302, "https://tmdb-proxy.me-zhuxy.workers.dev${b.1}")

# ===== 直连模式（开关关闭）：仅修正 include_adult =====
request if ${cfproxy} == false && ${url} ~= /^https?:\/\/api\.themoviedb\.org\/([^?#]*\?.*include_adult=)(?:1|false)(.*)$/ as c then redirect(302, "https://api.themoviedb.org/${c.1}true${c.2}")
request if ${cfproxy} == false && ${url} ~= /^(?!.*include_adult=)(https?:\/\/api\.themoviedb\.org\/[^?#]*\?[^#]*)$/ as d then redirect(302, "${d.1}&include_adult=true")

# ===== T66Y 移动版跳转 =====
^https?:\/\/www\.t66y\.com\/\/htm_data\/(\d+)\/(\d+)\/(\d+\.html)$ 302 https://www.t66y.com//htm_mob/$1/$2/$3

# ===== Forward 解锁搜索限制 =====
^https?:\/\/forwardinfo\.vvebo\.vip\/search\/multi\?(.*&)?include_adult=false(&.*)?$ 302 https://forwardinfo.vvebo.vip/search/multi?$1include_adult=true$2

# ===== DriveMBY 解锁搜索限制 =====
^https:\/\/drivemby\.inch\.red\/api\/library\/search-tmdb\?(?!.*include_adult=)(.*)$ 302 https://drivemby.inch.red/api/library/search-tmdb?$1&include_adult=true
^https:\/\/drivemby\.inch\.red\/api\/library\/search-tmdb\?(.*&)?include_adult=false(&.*)?$ 302 https://drivemby.inch.red/api/library/search-tmdb?$1include_adult=true$2

[Script]
# 响应侧过滤：反代域名和直连域名都匹配
http-response ^https?:\/\/(?:api\.themoviedb\.org|tmdb-proxy\.me-zhuxy\.workers\.dev)\/3\/(?:search|person|movie|tv) script-path=https://raw.githubusercontent.com/EmrysChoo/Proxy/main/Loon/scripts/tmdb_adult_filter.js,requires-body=true,tag=TMDB Adult Filter
http-response ^https:\/\/drivemby\.inch\.red\/api\/library\/search-tmdb script-path=https://raw.githubusercontent.com/EmrysChoo/Proxy/main/Loon/scripts/tmdb_adult_filter.js,requires-body=true,tag=DriveMBY Adult Filter

[MITM]
hostname = api.themoviedb.org, image.tmdb.org, tmdb-proxy.me-zhuxy.workers.dev, forwardinfo.vvebo.vip, www.t66y.com, drivemby.inch.red
